{
  "name": "psprokofiev/laravel-repository",
  "description": "Laravel Repository Pattern",
  "license": "MIT",
  "type": "library",
  "version": "1.9",
  "authors": [
    {
      "name": "Prokofiev Pavel",
      "email": "ps.prokofiev@gmail.com"
    }
  ],
  "require": {
    "php": "^8.0",
    "laravel/framework": "^10.0 || ^11.0 || ^12.0",
    "webmozart/assert": "^1.11"
  },
  "require-dev": {
    "ergebnis/composer-normalize": "^2.44",
    "friendsofphp/php-cs-fixer": "^3.68",
    "rector/rector": "^2.0"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "Psprokofiev\\LaravelRepository\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "ergebnis/composer-normalize": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Psprokofiev\\LaravelRepository\\Providers\\LaravelRepositoryProvider"
      ]
    }
  }
}
